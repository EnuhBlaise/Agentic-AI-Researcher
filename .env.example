# --- LLM (required) ---------------------------------------------------------
# Any OpenAI-compatible API works. OPENAI_API_KEY is also accepted.
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini

# Leave empty for OpenAI. Set it to use another provider, for example:
#   OpenRouter: https://openrouter.ai/api/v1
#   Ollama:     http://localhost:11434/v1   (LLM_API_KEY can be any text)
LLM_BASE_URL=

# --- Web search (optional) --------------------------------------------------
# Without it the agents still search arXiv and Wikipedia (no key needed).
TAVILY_API_KEY=

# --- Output (optional) ------------------------------------------------------
OUTPUT_DIR=outputs
